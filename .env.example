# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored. Keys are read from the environment at runtime;
# they are never written into any script or committed to the repo.

# D-ID Talks API key (from https://studio.d-id.com -> API keys)
DID_API_KEY=

# ElevenLabs API key (from https://elevenlabs.io -> Profile -> API key)
# Only needed for the upgraded-voice path in elevenlabs_voice.py
ELEVENLABS_API_KEY=
